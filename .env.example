# ── Cardmarket (Dedicated App) ──────────────────────────────────────────────
# Zu finden unter: MKM → Konto → Dedicated Apps → App-Details
MKM_APP_TOKEN=your_app_token_here
MKM_APP_SECRET=your_app_secret_here
MKM_ACCESS_TOKEN=your_access_token_here
MKM_ACCESS_SECRET=your_access_token_secret_here

# Optional: Sandbox-URL für Tests (Standard: https://apiv2.cardmarket.com/ws/v2.0)
# MKM_BASE_URL=https://sandbox.cardmarket.com/ws/v2.0

# ── eBay Developer ───────────────────────────────────────────────────────────
# Zu finden unter: developer.ebay.com → Application Keys → Production Keyset
EBAY_CLIENT_ID=your_ebay_client_id
EBAY_CLIENT_SECRET=your_ebay_client_secret

# Marktplatz-ID (Standard: EBAY_DE für Deutschland)
EBAY_MARKETPLACE_ID=EBAY_DE

# ── Allgemein ────────────────────────────────────────────────────────────────
# Pfad zur SQLite-Datenbank (Standard: pokeprice.db im Arbeitsverzeichnis)
POKEPRICE_DB=pokeprice.db

# Pause zwischen API-Calls in Sekunden (Standard: 1.0)
POKEPRICE_DELAY=1.0
